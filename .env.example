# Local-first: no model weights, no paid APIs in offline mode.
APP_ENV=dev
APP_MODE=offline
APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=./runtime
STORAGE_BACKEND=sqlite
CHECKPOINT_BACKEND=sqlite
AUTH_SECRET=dev-only-retrade-signing-secret-change-me
ADMIN_API_KEY=dev-admin-change-me

# Original ReTrade_V2 names retained. Import your local .env with scripts/import_env.py.
AIROBOT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AIROBOT_LLM_MODEL=qwen-plus
AIROBOT_LLM_API_KEY=
AIROBOT_LLM_TEMPERATURE=0.1
AIROBOT_LLM_TIMEOUT=45
AIROBOT_STRUCTURED_OUTPUT_METHOD=function_calling
AIROBOT_LLM_EXTRA_BODY={}
AIROBOT_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
AIROBOT_EMBEDDING_MODEL=Pro/BAAI/bge-m3
AIROBOT_EMBEDDING_API_KEY=
AIROBOT_RERANK_PROVIDER=siliconflow
AIROBOT_RERANK_ENABLED=true
AIROBOT_RERANK_BASE_URL=https://api.siliconflow.cn/v1
AIROBOT_RERANK_MODEL=BAAI/bge-reranker-v2-m3
AIROBOT_RERANK_API_KEY=
AIROBOT_RERANK_TIMEOUT=15

# local = persistent local vectors; milvus = your existing Docker service.
AIROBOT_VECTOR_STORE=local
AIROBOT_MILVUS_URI=http://localhost:19530
AIROBOT_MILVUS_TOKEN=
AIROBOT_MILVUS_COLLECTION=retrade_langgraph_kb
AIROBOT_MILVUS_RESET_ON_START=false
AIROBOT_TOP_K=5
AIROBOT_CHUNK_SIZE=500
AIROBOT_CHUNK_OVERLAP=80
AIROBOT_HYBRID_VECTOR_TOP_K=15
AIROBOT_HYBRID_BM25_TOP_K=15
AIROBOT_HYBRID_FUSION_TOP_K=10

# Empty REDIS_URL uses local TTL cache + local rate-limit.
REDIS_URL=
AIROBOT_CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
AIROBOT_RATELIMIT_PER_MINUTE=60
MAX_HANDOFFS=3
MAX_AGENT_STEPS=12
MAX_TOOL_FAILURES=2
MAX_REQUEST_SECONDS=180
MAX_UPLOAD_MB=10

# Reserved. Never used when STORAGE_BACKEND/CHECKPOINT_BACKEND=sqlite.
ASYNC_DATABASE_URL=
LANGGRAPH_DATABASE_URL=
LANGGRAPH_STRICT_MSGPACK=true
